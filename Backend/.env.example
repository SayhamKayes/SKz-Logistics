# SAIN International Logistics - Backend Environment Configuration
SECRET_KEY=django-insecure-sain-logistics-2026-secret-key-bangladesh
DEBUG=True
ALLOWED_HOSTS=*

# Active Database Selector: "postgres" | "neon" | "supabase" | "sqlite"
DB_PROVIDER=neon

# 1. Local PostgreSQL Configuration
POSTGRES_DB=sain_db
POSTGRES_USER=sain_user
POSTGRES_PASSWORD=sain_secure_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 2. Neon.tech (Serverless Postgres) URL
NEON_DATABASE_URL=postgresql://sain_admin:neon_key@ep-logistics-dhaka-01.us-east-2.aws.neon.tech/sain_logistics?sslmode=require

# 3. Supabase Database Pooling URL
SUPABASE_DATABASE_URL=postgresql://postgres.sain-logistics:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# CORS Configuration for React Frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://saininternationallogistics.com

# 4. SMTP Email Gateway Configuration (for Contact Form & Admin Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=saininternationallogistics@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_SENDER_NAME="SAIN International Logistics"

# 5. Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Target folder created in your Cloudinary Dashboard:
CLOUDINARY_FOLDER=your_cloudinary_folder_name
# Optional: Set to true if you want subcategories inside your main folder
CLOUDINARY_USE_SUBFOLDERS=false
# Optional alternative: CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
